{
  "expo": {
    "name": "TWINI",
    "slug": "twini",
    "scheme": [
      "twini",
      "com.twini.app"
    ],
    "version": "1.0.19",
    "orientation": "default",
    "icon": "./src/assets/imageTwini/gg_icon-IDTC-app.png",
    "ios": {
      "bundleIdentifier": "com.twini.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.twini.app",
      "versionCode": 20,
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/imageTwini/gg_icon-IDTC.png",
        "backgroundColor": "#0873bd"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/twini-logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/twini-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#090f1b"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio"
    ]
  }
}
